PORT=3445
# Interfaz de escucha; 127.0.0.1 detrás de Apache (por defecto)
HOST=127.0.0.1
FRONTEND_CLIENT=http://localhost:3000

# Base de datos (kg_portal en producción)
DB_HOST=dbhost
DB_USER=dbuser
DB_PASS=dbpass
DB_DATABASE=kg_portal

# Redis (usuario y contraseña de su ACL; vacíos si no tiene)
REDIS_HOST=redishost
REDIS_PORT=6379
REDIS_USER=redisuser
REDIS_PASS=redispass
# Prefijo de las claves: único por proyecto porque Redis es compartido
SECRET_KEY_CACHE=kg_portal

# URL pública del frontend (enlaces de los correos)
APP_URL=http://localhost:3000

# SMTP de INTARCON
SMTP_HOST=smtp.intarcon.es
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=smtpuser
SMTP_PASS=smtppass
SMTP_FROM="Portal KEYTER Group <smtpuser>"

# Odoo 19 por JSON-2 (módulos de Recepción). Las visitas envían correos: en local, siempre el Odoo de pruebas
ODOO_HOST=https://odoo.example.com
ODOO_DB=odoodb
ODOO_API_KEY=odooapikey
ODOO_COMPANY_ID=1
ODOO_TIMEOUT_MS=30000
