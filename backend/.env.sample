PORT=port
FRONTEND_CLIENT =*

# Database configuration
DB_HOST=dbhost
DB_USER=dbuser
DB_PASS=dbpass
DB_DATABASE=dbdatabase

# Redis configuration
REDIS_HOST=redishost
REDIS_PORT=redisport
SECRET_KEY_CACHE=secretkeycache

# Application URL
APP_URL=appurl

# SMTP configuration
SMTP_HOST=smtphost
SMTP_PORT=smtpport
SMTP_SECURE=smtpsecure
SMTP_USER=smtpuser
SMTP_PASS=smtppass
SMTP_FROM="Nombre <email@dominio.com>"
